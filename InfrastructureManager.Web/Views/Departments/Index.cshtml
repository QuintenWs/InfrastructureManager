@model IEnumerable<InfrastructureManager.Web.ViewModels.Departments.DepartmentListViewModel>

@{
    ViewData["Title"] = "Departments";
}

<div class="page-header">
    <div>
        <div class="page-subtitle">Organisational Units</div>
        <h1 class="page-heading">Departments</h1>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary custom-btn">
            <i class="bi bi-plus-lg"></i> Add Department
        </a>
    </div>
</div>

<div class="content-card mb-4">
    <form method="get" class="row g-3">
        <div class="col-md-8">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Search departments..." />
            </div>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary custom-btn w-100">
                <i class="bi bi-search"></i> Search
            </button>
            <a asp-action="Index" class="btn btn-light custom-btn">Reset</a>
        </div>
    </form>
</div>

<div class="content-card">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-building"></i></div>
            <div class="empty-title">No departments found</div>
        </div>
    }
    else
    {
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Department</th>
                    <th>Location</th>
                    <th>Address</th>
                    <th>Added</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="table-link fw-semibold">
                                @item.Name
                            </a>
                            @if (item.OpenActionItemCount > 0)
                            {
                                <a asp-controller="Visits" asp-action="Index" asp-route-departmentId="@item.Id"
                                   class="status-badge status-maintenance ms-2" style="font-size:.7rem">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                    @item.OpenActionItemCount open
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <div class="table-subtitle">@item.Description</div>
                            }
                        </td>
                        <td>@item.LocationName</td>
                        <td>@item.Address</td>
                        <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <div class="table-actions">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light">View</a>
                                <a asp-action="Edit"    asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                      onsubmit="return confirm('Delete department @item.Name?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
