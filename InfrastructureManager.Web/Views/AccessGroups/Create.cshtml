@model InfrastructureManager.Web.ViewModels.AccessGroups.CreateAccessGroupViewModel

@{
    ViewData["Title"] = "Nieuwe toegangsgroep";
}

<div class="page-header">
    <div>
        <div class="breadcrumb-nav">
            <a asp-action="Index">Toegangsgroepen</a><span>/</span><span>Nieuw</span>
        </div>
        <h1 class="page-heading">Nieuwe toegangsgroep</h1>
    </div>
</div>

<div class="form-page">
    <div class="form-card">
        <form asp-action="Create" method="post">
            <partial name="_ValidationSummary" />

            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control custom-input" placeholder="bv. IT Operations Antwerpen" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="form-group mt-3">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" rows="2" class="form-control custom-input"></textarea>
            </div>

            <div class="form-check mt-3">
                <input asp-for="CanViewHistory" class="form-check-input" />
                <label asp-for="CanViewHistory" class="form-check-label"></label>
                <div class="text-secondary small mt-1">
                    Leden van deze groep mogen de audit-geschiedenis bekijken,
                    beperkt tot hun eigen departementen.
                </div>
            </div>

            <div class="form-actions mt-4">
                <a asp-action="Index" class="btn btn-light custom-btn">Cancel</a>
                <button type="submit" class="btn btn-primary custom-btn">
                    <i class="bi bi-check-lg"></i> Groep aanmaken
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}