@model IEnumerable<InfrastructureManager.Web.ViewModels.AccessGroups.AccessGroupListViewModel>

@{
    ViewData["Title"] = "Access Groups";
}

<div class="page-header">
    <div>
        <div class="page-subtitle">Access Control</div>
        <h1 class="page-heading">Access Groups</h1>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary custom-btn">
            <i class="bi bi-plus-lg"></i> New Group
        </a>
    </div>
</div>

<div class="content-card">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-people-fill"></i></div>
            <div class="empty-title">No groups yet</div>
            <div class="empty-description">
                Create a group to assign departments/locations to multiple
                users in one go.
            </div>
        </div>
    }
    else
    {
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Scopes</th>
                    <th>Members</th>
                    <th>History</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            <a asp-action="Details" asp-route-id="@g.Id" class="table-link">@g.Name</a>
                        </td>
                        <td class="text-secondary">@(g.Description ?? "-")</td>
                        <td>
                            <span class="status-badge status-active" style="font-size:.78rem">
                                @g.DepartmentGrantCount department@(g.DepartmentGrantCount == 1 ? "" : "s")
                            </span>
                            @if (g.LocationGrantCount > 0)
                            {
                                <span class="status-badge status-maintenance ms-1" style="font-size:.78rem">
                                    @g.LocationGrantCount location@(g.LocationGrantCount == 1 ? "" : "s")
                                </span>
                            }
                        </td>
                        <td>@g.MemberCount</td>
                        <td>
                            @if (g.CanViewHistory)
                            {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            }
                            else
                            {
                                <span class="text-secondary">—</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="table-actions">
                                <a asp-action="Details" asp-route-id="@g.Id" class="btn btn-sm btn-light">Manage</a>
                                <a asp-action="Edit" asp-route-id="@g.Id" class="btn btn-sm btn-primary">Edit</a>
                                <form asp-action="Delete" asp-route-id="@g.Id" method="post"
                                      onsubmit="return confirm('Delete group @g.Name? Members will lose the access that came only from this group.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>