@model InfrastructureManager.Application.DTOs.Visits.SiteVisitDto
@using InfrastructureManager.Infrastructure.Identity

@{
    ViewData["Title"] = "Visit Details";
}

<div class="page-header">
    <div>
        <div class="breadcrumb-nav">
            <a asp-action="Index" asp-route-departmentId="@Model.DepartmentId">Visits</a>
            <span>/</span><span>@Model.VisitDate.ToString("dd/MM/yyyy")</span>
        </div>
        <h1 class="page-heading">@Model.DepartmentName — @Model.VisitDate.ToString("dd/MM/yyyy")</h1>
        <div class="text-secondary small">@Model.LocationName &nbsp;·&nbsp; by @Model.UserDisplayName</div>
    </div>
    @if (User.IsInRole(AppRoles.Admin))
    {
        <form asp-action="Delete" asp-route-id="@Model.Id" asp-route-departmentId="@Model.DepartmentId" method="post"
              onsubmit="return confirm('Delete this visit? This cannot be undone. Action items linked to it will remain, but lose their link to this visit.');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger custom-btn">
                <i class="bi bi-trash"></i> Delete Visit
            </button>
        </form>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.Summary))
{
    <div class="content-card mb-4">
        <div class="details-section-title">General notes</div>
        <div class="notes-content">@Model.Summary</div>
    </div>
}

<div class="content-card mb-4">
    <div class="details-section-title">Items resolved during this visit (@Model.ResolvedItems.Count)</div>
    @if (!Model.ResolvedItems.Any())
    {
        <div class="empty-notes">No items resolved during this visit.</div>
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var item in Model.ResolvedItems)
            {
                <div class="content-card" style="background:var(--color-success-bg); border-color:#d3ecdd">
                    <div class="fw-semibold">@item.Description</div>
                    @if (!string.IsNullOrWhiteSpace(item.ResolutionNotes))
                    {
                        <div class="text-secondary small mt-1">@item.ResolutionNotes</div>
                    }
                </div>
            }
        </div>
    }
</div>

<div class="content-card">
    <div class="details-section-title">New items noted (@Model.NewItems.Count)</div>
    @if (!Model.NewItems.Any())
    {
        <div class="empty-notes">No new items noted during this visit.</div>
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var item in Model.NewItems)
            {
                <div class="content-card" style="background:var(--color-surface-subtle)">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div class="fw-semibold">@item.Description</div>
                        <partial name="_PriorityBadge" model="item.Priority" />
                    </div>
                </div>
            }
        </div>
    }
</div>