@using Microsoft.AspNetCore.Identity
@using InfrastructureManager.Infrastructure.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser>   UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InfrastructureManager</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/layout.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <link rel="stylesheet" href="~/css/components.css" />
</head>

<body>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var user = SignInManager.IsSignedIn(User)
        ? await UserManager.GetUserAsync(User)
        : null;
    var initials    = user != null
        ? $"{user.FirstName.FirstOrDefault()}{user.LastName.FirstOrDefault()}".ToUpper()
        : "?";
    var displayName = user != null
        ? $"{user.FirstName} {user.LastName}".Trim()
        : string.Empty;
    var isAdmin = User.IsInRole(AppRoles.Admin);
}

<div class="app-layout" id="appLayout">

    <aside class="sidebar" id="sidebar">

        <div class="sidebar-toggle" id="sidebarToggle" title="Toggle sidebar">
            <i class="bi bi-chevron-left" id="toggleIcon"></i>
        </div>

        <div class="sidebar-header">
            <div class="logo-icon"><i class="bi bi-hdd-network"></i></div>
            <div>
                <div class="logo-title">Infrastructure</div>
                <div class="logo-subtitle">Manager</div>
            </div>
        </div>

        <nav class="sidebar-nav">

            <a asp-controller="Dashboard" asp-action="Index"
               class="nav-item @(currentController == "Dashboard" ? "active" : "")"
               title="Dashboard">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
            </a>

            <a asp-controller="Locations" asp-action="Index"
               class="nav-item @(currentController == "Locations" ? "active" : "")"
               title="Locations">
                <i class="bi bi-geo-alt"></i>
                <span>Locations</span>
            </a>

            <a asp-controller="Departments" asp-action="Index"
               class="nav-item @(currentController == "Departments" ? "active" : "")"
               title="Departments">
                <i class="bi bi-building"></i>
                <span>Departments</span>
            </a>

            <a asp-controller="Networks" asp-action="Index"
               class="nav-item @(currentController == "Networks" ? "active" : "")"
               title="Networks">
                <i class="bi bi-diagram-3"></i>
                <span>Networks</span>
            </a>

            <a asp-controller="Topology" asp-action="Index"
               class="nav-item @(currentController == "Topology" ? "active" : "")"
               title="Topology">
                <i class="bi bi-share"></i>
                <span>Topology</span>
            </a>

            <a asp-controller="Devices" asp-action="Index"
               class="nav-item @(currentController == "Devices" ? "active" : "")"
               title="Devices">
                <i class="bi bi-pc-display"></i>
                <span>Devices</span>
            </a>

            <a asp-controller="Visits" asp-action="Index"
               class="nav-item @(currentController == "Visits" ? "active" : "")"
               title="Bezoeken">
                <i class="bi bi-clipboard-check"></i>
                <span>Bezoeken</span>
            </a>

            <a asp-controller="InventoryChecks" asp-action="Index"
               class="nav-item @(currentController == "InventoryChecks" ? "active" : "")"
               title="Controles">
                <i class="bi bi-clipboard-data"></i>
                <span>Controles</span>
            </a>

            <a asp-controller="Contacts" asp-action="Index"
               class="nav-item @(currentController == "Contacts" ? "active" : "")"
               title="Contacts">
                <i class="bi bi-people"></i>
                <span>Contacts</span>
            </a>

            @if (isAdmin)
            {
                <div class="sidebar-section-label">Admin</div>

                <a asp-controller="Users" asp-action="Index"
                   class="nav-item @(currentController == "Users" ? "active" : "")"
                   title="Users">
                    <i class="bi bi-person-gear"></i>
                    <span>Users</span>
                </a>

                <a asp-controller="Import" asp-action="Index"
                   class="nav-item @(currentController == "Import" ? "active" : "")"
                   title="Import">
                    <i class="bi bi-file-earmark-arrow-up"></i>
                    <span>Import</span>
                </a>

                <a asp-controller="DeviceTypes" asp-action="Index"
                   class="nav-item @(currentController == "DeviceTypes" ? "active" : "")"
                   title="Device Types">
                    <i class="bi bi-cpu"></i>
                    <span>Device Types</span>
                </a>

                <a asp-controller="History" asp-action="Index"
                   class="nav-item @(currentController == "History" ? "active" : "")"
                   title="Geschiedenis">
                    <i class="bi bi-clock-history"></i>
                    <span>Geschiedenis</span>
                </a>

                <a asp-controller="DevTools" asp-action="Index"
                   class="nav-item @(currentController == "DevTools" ? "active" : "")"
                   title="Testdata">
                    <i class="bi bi-magic"></i>
                    <span>Testdata</span>
                </a>
            }

        </nav>

    </aside>

    <main class="main-content">

        <header class="topbar">
            <div class="topbar-search">
                <form asp-controller="Search" asp-action="Index" method="get"
                      class="d-flex align-items-center gap-2">
                    <div class="search-box" style="width:100%;max-width:340px">
                        <i class="bi bi-search"></i>
                        <input type="text"
                               name="q"
                               placeholder="Zoek toestellen, contacten, bezoeken..."
                               value="@(currentController == "Search"
                                       ? Context.Request.Query["q"].ToString()
                                       : string.Empty)" />
                    </div>
                </form>
            </div>

            <div class="topbar-actions">
                @if (user != null)
                {
                    @if (!isAdmin)
                    {
                        <span class="status-badge status-offline" style="font-size:.7rem">
                            Viewer
                        </span>
                    }
                    <span class="text-secondary small d-none d-lg-inline">@displayName</span>
                    <form asp-controller="Auth" asp-action="Logout"
                          method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-light btn-sm" title="Sign out">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                    <div class="user-avatar ms-1" title="@displayName">@initials</div>
                }
            </div>
        </header>

        <section class="content-area">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success custom-alert alert-dismissible fade show"
                     role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @TempData["Success"]
                    <button type="button" class="btn-close"
                            data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger custom-alert alert-dismissible fade show"
                     role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @TempData["Error"]
                    <button type="button" class="btn-close"
                            data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()

        </section>

    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // Sidebar toggle
    (function () {
        var sidebar   = document.getElementById('sidebar');
        var toggle    = document.getElementById('sidebarToggle');
        var icon      = document.getElementById('toggleIcon');
        var KEY       = 'sidebar_collapsed';

        function applyState(collapsed) {
            if (collapsed) {
                sidebar.classList.add('collapsed');
                icon.className = 'bi bi-chevron-right';
            } else {
                sidebar.classList.remove('collapsed');
                icon.className = 'bi bi-chevron-left';
            }
        }

        // Restore saved state
        var saved = localStorage.getItem(KEY);
        if (saved === 'true') applyState(true);

        toggle.addEventListener('click', function () {
            var isCollapsed = sidebar.classList.contains('collapsed');
            applyState(!isCollapsed);
            localStorage.setItem(KEY, !isCollapsed);
        });
    })();
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
