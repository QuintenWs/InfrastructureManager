@model string
@{
    var cls = Model switch
    {
        "Resolved"   => "status-active",
        "InProgress" => "status-maintenance",
        _            => "status-offline"
    };
    var label = Model switch
    {
        "Resolved"   => "Resolved",
        "InProgress" => "In Progress",
        _            => "Open"
    };
}
<span class="status-badge @cls">@label</span>