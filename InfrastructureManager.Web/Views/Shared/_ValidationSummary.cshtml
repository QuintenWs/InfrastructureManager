@* Toon een rode samenvatting als er ModelState-fouten zijn.
   Gebruik: <partial name="_ValidationSummary" /> bovenaan elk formulier. *@

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger custom-alert mb-4" role="alert">
        <div class="d-flex align-items-center gap-2 mb-2">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <strong>Please fix the following errors before saving:</strong>
        </div>
        <ul class="mb-0 ps-3">
            @foreach (var entry in ViewData.ModelState.Values)
            {
                foreach (var error in entry.Errors)
                {
                    <li>@error.ErrorMessage</li>
                }
            }
        </ul>
    </div>
}
