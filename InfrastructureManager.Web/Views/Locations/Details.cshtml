@model InfrastructureManager.Web.ViewModels.Locations.LocationDetailsViewModel
@using InfrastructureManager.Infrastructure.Identity

@{
    ViewData["Title"] = Model.Name;
}

<div class="details-header">
    <div>
        <div class="breadcrumbs">
            <a asp-action="Index">Locations</a>
            <span>/</span>
            <span>@Model.Name</span>
        </div>
        <h1 class="details-title">@Model.Name</h1>
        <div class="details-subtitle">@Model.City, @Model.Country</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary custom-btn">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-controller="Departments" asp-action="Create"
           asp-route-locationId="@Model.Id" class="btn btn-light custom-btn">
            <i class="bi bi-plus-lg"></i> Add Department
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="content-card text-center">
            <div style="font-size:2rem;font-weight:600">@Model.Departments.Count()</div>
            <div class="text-secondary small">Departments</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="content-card text-center">
            <div style="font-size:2rem;font-weight:600">@Model.Networks.Count()</div>
            <div class="text-secondary small">Networks</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="content-card text-center">
            <div style="font-size:2rem;font-weight:600">@Model.Devices.Count()</div>
            <div class="text-secondary small">Devices</div>
        </div>
    </div>
</div>

<div class="details-grid">
    <div class="details-main">

        <div class="content-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="details-section-title mb-0">Departments</div>
                <a asp-controller="Departments" asp-action="Create"
                   asp-route-locationId="@Model.Id" class="btn btn-sm btn-light">
                    <i class="bi bi-plus-lg"></i> Add
                </a>
            </div>
            @if (!Model.Departments.Any())
            {
                <div class="empty-notes">No departments at this location yet.</div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var d in Model.Departments)
                    {
                        <div class="col-md-6">
                            <a asp-controller="Departments" asp-action="Details"
                               asp-route-id="@d.Id" class="dept-card-link">
                                <div class="dept-card">
                                    <div class="dept-card-icon">
                                        <i class="bi bi-building"></i>
                                    </div>
                                    <div class="dept-card-body">
                                        <div class="dept-card-name">@d.Name</div>
                                        <div class="dept-card-address text-secondary small">
                                            @d.Address
                                        </div>
                                        <div class="dept-card-meta text-secondary small mt-1">
                                            @d.ContactCount contact@(d.ContactCount == 1 ? "" : "s")
                                        </div>
                                    </div>
                                    <i class="bi bi-chevron-right text-secondary"></i>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            }
        </div>

    </div>

    <div class="details-sidebar">
        <div class="content-card">
            <div class="details-section-title">Quick Actions</div>
            <div class="quick-actions">
                <a asp-action="Edit" asp-route-id="@Model.Id"
                   class="btn btn-primary custom-btn">
                    <i class="bi bi-pencil"></i> Edit Location
                </a>
                <a asp-controller="Departments" asp-action="Create"
                   asp-route-locationId="@Model.Id" class="btn btn-light custom-btn">
                    <i class="bi bi-building"></i> Add Department
                </a>
                <a asp-controller="Devices" asp-action="Index"
                   asp-route-locationId="@Model.Id" class="btn btn-light custom-btn">
                    <i class="bi bi-pc-display"></i> All Devices
                </a>
                <a asp-controller="Networks" asp-action="Index"
                   asp-route-locationId="@Model.Id" class="btn btn-light custom-btn">
                    <i class="bi bi-diagram-3"></i> All Networks
                </a>
                <a asp-action="Index" class="btn btn-light custom-btn">Back to Locations</a>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="content-card mt-3">
                <div class="details-section-title">Notes</div>
                <div class="notes-content">@Model.Notes</div>
            </div>
        }
    </div>
</div>
