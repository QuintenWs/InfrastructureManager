@model IEnumerable<InfrastructureManager.Web.ViewModels.Locations.LocationListViewModel>

@{
    ViewData["Title"] = "Locations";
}

<div class="page-header">
    <div>
        <div class="page-subtitle">Geographic Overview</div>
        <h1 class="page-heading">Locations</h1>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary custom-btn">
            <i class="bi bi-plus-lg"></i> Add Location
        </a>
    </div>
</div>

<div class="content-card mb-4">
    <form method="get" class="row g-3">
        <div class="col-md-8">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Search locations..." />
            </div>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary custom-btn w-100">
                <i class="bi bi-search"></i> Search
            </button>
            <a asp-action="Index" class="btn btn-light custom-btn">Reset</a>
        </div>
    </form>
</div>

<div class="content-card">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-geo-alt"></i></div>
            <div class="empty-title">No locations found</div>
            <div class="empty-description">Add your first geographic location.</div>
        </div>
    }
    else
    {
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Location</th>
                    <th>City</th>
                    <th>Country</th>
                    <th>Departments</th>
                    <th>Networks</th>
                    <th>Devices</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            <a asp-action="Details" asp-route-id="@item.Id" class="table-link">
                                @item.Name
                            </a>
                        </td>
                        <td>@item.City</td>
                        <td>@item.Country</td>
                        <td>@item.DepartmentCount</td>
                        <td>@item.NetworkCount</td>
                        <td>@item.DeviceCount</td>
                        <td class="text-end">
                            <div class="table-actions">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light">View</a>
                                <a asp-action="Edit"    asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                      onsubmit="return confirm('Delete location @item.Name and all its data?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <partial name="_Pagination" model="(InfrastructureManager.Web.ViewModels.Shared.PaginationViewModel)ViewBag.Pagination" />
    }
</div>