@model InfrastructureManager.Web.ViewModels.Users.CreateUserViewModel

@{
    ViewData["Title"] = "Add User";
}

<div class="page-header">
    <div>
        <div class="breadcrumb-nav">
            <a asp-action="Index">Users</a><span>/</span><span>Add</span>
        </div>
        <h1 class="page-heading">Add User</h1>
    </div>
</div>

<div class="form-page">
    <div class="form-card">
        <form asp-action="Create" method="post">

            <partial name="_ValidationSummary" />

            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="FirstName"></label>
                    <input asp-for="FirstName" class="form-control custom-input" />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LastName"></label>
                    <input asp-for="LastName" class="form-control custom-input" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="form-control custom-input" type="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" class="form-control custom-input" type="password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

            </div>

            <div class="content-card mt-4" style="background:var(--surface-raised,#f8f7f4)">
                <div class="details-section-title">Permissions</div>
                <div class="row g-3">
                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="IsAdmin" class="form-check-input" />
                            <label asp-for="IsAdmin" class="form-check-label fw-semibold"></label>
                            <div class="text-secondary small mt-1">
                                Admins can create, edit and delete everything.
                                Viewers can only read.
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-actions mt-4">
                <a asp-action="Index" class="btn btn-light custom-btn">Cancel</a>
                <button type="submit" class="btn btn-primary custom-btn">
                    <i class="bi bi-check-lg"></i> Create User
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
