@model InfrastructureManager.Web.ViewModels.Users.CreateUserViewModel

@{
    ViewData["Title"] = "Add User";
}

<div class="page-header">
    <div>
        <div class="breadcrumb-nav">
            <a asp-action="Index">Users</a><span>/</span><span>Add</span>
        </div>
        <h1 class="page-heading">Add User</h1>
    </div>
</div>

<form asp-action="Create" method="post">

    <partial name="_ValidationSummary" />

    <div class="content-card mb-4">
        <div class="details-section-title">Accountgegevens</div>
        <div class="form-grid">

            <div class="form-group">
                <label asp-for="FirstName"></label>
                <input asp-for="FirstName" class="form-control custom-input" />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label asp-for="LastName"></label>
                <input asp-for="LastName" class="form-control custom-input" />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control custom-input" type="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control custom-input" type="password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

        </div>
    </div>

    <div class="content-card mb-4">
        <div class="details-section-title">Rechten</div>

        <div class="row g-4">
            <div class="col-md-7">
                <label asp-for="Role" class="form-label fw-semibold"></label>
                <select asp-for="Role" class="form-select" id="roleSelect">
                    <option value="Viewer">Viewer — enkel lezen, binnen zijn scope</option>
                    <option value="Editor">Editor — mag wijzigen, binnen zijn scope</option>
                    <option value="Admin">Admin — onbeperkt, kan alles beheren</option>
                </select>
                <div class="text-secondary small mt-2">
                    Viewer en Editor zien enkel de departementen uit hun groepen/uitzonderingen.
                </div>
            </div>

            <div class="col-md-5">
                <label class="form-label fw-semibold d-block">Status</label>
                <div class="form-check form-switch mt-2">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>
    </div>

    <div class="content-card mb-4" id="groupsSection">
        <div class="details-section-title">Toegangsgroepen</div>
        <div class="text-secondary small mb-3">
            Kies in welke groepen deze gebruiker start. Kan later nog aangepast worden.
        </div>

        @if (!Model.AvailableGroups.Any())
        {
            <div class="empty-notes">
                Nog geen groepen aangemaakt. Ga naar
                <a asp-controller="AccessGroups" asp-action="Index">Toegangsgroepen</a>
                om er een aan te maken.
            </div>
        }
        else
        {
            <div class="row g-2">
                @foreach (var group in Model.AvailableGroups)
                {
                    <div class="col-md-6">
                        <label class="d-flex align-items-center gap-2 p-3 mb-0"
                               style="border:1px solid var(--color-border);border-radius:var(--radius-md);cursor:pointer;background:var(--color-surface);">
                            <input type="checkbox" class="form-check-input m-0 flex-shrink-0"
                                   name="AccessGroupIds" value="@group.Value" />
                            <span style="font-size:13.5px;font-weight:600">@group.Text</span>
                        </label>
                    </div>
                }
            </div>
        }
    </div>

    <div class="form-actions">
        <a asp-action="Index" class="btn btn-light custom-btn">Cancel</a>
        <button type="submit" class="btn btn-primary custom-btn">
            <i class="bi bi-check-lg"></i> Create User
        </button>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const roleSelect    = document.getElementById('roleSelect');
        const groupsSection = document.getElementById('groupsSection');

        function toggleGroupsVisibility() {
            groupsSection.style.display = roleSelect.value === 'Admin' ? 'none' : '';
        }

        roleSelect.addEventListener('change', toggleGroupsVisibility);
        toggleGroupsVisibility();
    </script>
}