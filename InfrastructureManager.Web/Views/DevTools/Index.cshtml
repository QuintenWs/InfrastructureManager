@{
    ViewData["Title"] = "Testdata";
    bool exists = ViewBag.TestDataExists ?? false;
}

<div class="page-header">
    <div>
        <div class="page-subtitle">Ontwikkelaarstools</div>
        <h1 class="page-heading">Testdata genereren</h1>
    </div>
</div>

<div class="content-card mb-4">
    <div class="details-section-title">Wat wordt er aangemaakt?</div>
    <p class="text-secondary" style="font-size:.93rem">
        Eén nieuwe locatie <strong>"Testomgeving"</strong> met een volledige, realistische testset,
        zodat je alles kan uitproberen zonder je echte gegevens te raken:
    </p>
    <ul class="text-secondary" style="font-size:.9rem; line-height:1.8">
        <li>3 testdepartementen, elk met een eigen netwerk</li>
        <li>12 toestellen, waaronder 3 crypto-toestellen met verschillende sleutel-vervaldatums
            (1 verlopen, 1 binnenkort, 1 nog lang geldig — om het dashboard-widget te testen)</li>
        <li>3 contactpersonen</li>
        <li>Een volledige bezoekhistoriek: een opgelost punt, een punt "in behandeling" en een open punt</li>
        <li>2 digitale controles, waarvan 1 met een ontbrekend toestel en 1 met een testfoto</li>
        <li>1 departement bewust zonder bezoeken/controles, om de lege schermen te bekijken</li>
    </ul>

    @if (exists)
    {
        <div class="custom-alert alert-info">
            <i class="bi bi-info-circle-fill"></i>
            <span>Testdata staat er al. Verwijder ze eerst als je opnieuw wil genereren.</span>
        </div>
        <form asp-action="DeleteTestData" method="post"
              onsubmit="return confirm('Alle testdata (locatie \'Testomgeving\' en alles eronder) verwijderen? Dit kan niet ongedaan gemaakt worden.');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger custom-btn">
                <i class="bi bi-trash"></i> Testdata verwijderen
            </button>
        </form>
    }
    else
    {
        <form asp-action="SeedTestData" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary custom-btn">
                <i class="bi bi-magic"></i> Testdata genereren
            </button>
        </form>
    }
</div>

<div class="custom-alert alert-warning">
    <i class="bi bi-exclamation-triangle-fill"></i>
    <span>
        Dit scherm is enkel bedoeld om te testen. Overweeg deze pagina (of de hele
        <code>DevToolsController</code>) te verwijderen vlak voor je echt in productie gaat.
    </span>
</div>
