@model InfrastructureManager.Web.ViewModels.DeviceTypes.DeviceTypeIndexViewModel

@{
    ViewData["Title"] = "Device Types";
}

<div class="page-header">
    <div>
        <div class="page-subtitle">Configuration</div>
        <h1 class="page-heading">Device Types</h1>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary custom-btn">
            <i class="bi bi-plus-lg"></i> New Type
        </a>
    </div>
</div>

<div class="content-card">
    @if (!Model.Items.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-cpu"></i></div>
            <div class="empty-title">No device types defined</div>
            <div class="empty-description">Create a device type to define which attributes devices of that type have.</div>
        </div>
    }
    else
    {
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Type Name</th>
                    <th>Fields</th>
                    <th>Devices</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id"
                               class="table-link fw-semibold">@item.Name</a>
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <div class="table-subtitle">@item.Description</div>
                            }
                        </td>
                        <td>
                            <span class="status-badge status-@(item.FieldCount > 0 ? "active" : "offline")">
                                @item.FieldCount field@(item.FieldCount == 1 ? "" : "s")
                            </span>
                        </td>
                        <td>
                            @if (item.DeviceCount > 0)
                            {
                                <a asp-controller="Devices" asp-action="Index" asp-route-deviceType="@item.DeviceTypeValue"
                                class="table-link">@item.DeviceCount</a>
                            }
                            else
                            {
                                @item.DeviceCount
                            }
                        </td>
                        <td class="text-end">
                            <div class="table-actions">
                                <a asp-action="Details" asp-route-id="@item.Id"
                                class="btn btn-sm btn-light">Manage Fields</a>
                                <a asp-action="Edit" asp-route-id="@item.Id"
                                class="btn btn-sm btn-primary">Edit</a>

                                @* Altijd gerenderd, ook als niet van toepassing (visibility:hidden i.p.v.
                                weggelaten) — zo houdt elke knop dezelfde plaats in de rij aan, wat
                                deze en de prullenbak in élke rij op exact dezelfde positie zet. *@
                                <a asp-controller="Devices" asp-action="Index" asp-route-deviceType="@item.DeviceTypeValue"
                                class="btn btn-sm btn-light" title="This type is still in use — view its devices to reassign or remove them first"
                                style="@(item.DeviceCount > 0 ? "" : "visibility:hidden")"
                                tabindex="@(item.DeviceCount > 0 ? "0" : "-1")"
                                aria-hidden="@(item.DeviceCount > 0 ? "false" : "true")">
                                    <i class="bi bi-eye"></i> View Devices
                                </a>

                                @if (item.DeviceCount == 0)
                                {
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline-block"
                                        onsubmit="return confirm('Delete @item.Name and all its field definitions? This cannot be undone.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-danger" style="visibility:hidden" tabindex="-1" aria-hidden="true">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
            <partial name="_Pagination" model="Model.Pagination" />
    }
</div>