@* DeviceTypes/Create.cshtml *@
@model InfrastructureManager.Web.ViewModels.DeviceTypes.CreateDeviceTypeViewModel
@{
    ViewData["Title"] = "New Device Type";
}

<div class="page-header">
    <div>
        <div class="breadcrumb-nav">
            <a asp-action="Index">Device Types</a><span>/</span><span>New</span>
        </div>
        <h1 class="page-heading">New Device Type</h1>
    </div>
</div>

<div class="form-page">
    <div class="form-card">
        <form asp-action="Create" method="post">
            <partial name="_ValidationSummary" />
            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="Name"></label>
                    <input asp-for="Name" class="form-control custom-input"
                           placeholder="e.g. Industrial Switch, Crypto Device" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Description"></label>
                    <input asp-for="Description" class="form-control custom-input" />
                </div>
            </div>
            <div class="text-secondary small mt-2">
                After creating the type you can add fields (IP address, MAC, firmware version, etc.)
            </div>
            <div class="form-actions mt-4">
                <a asp-action="Index" class="btn btn-light custom-btn">Cancel</a>
                <button type="submit" class="btn btn-primary custom-btn">
                    <i class="bi bi-check-lg"></i> Create &amp; Add Fields
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
