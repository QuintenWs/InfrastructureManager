@{
    ViewData["Title"] = "Access Denied";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied – InfrastructureManager</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        body { background: var(--bs-body-bg, #f5f5f5); }
        .denied-wrap {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .denied-card {
            width: 100%;
            max-width: 460px;
            background: #fff;
            border-radius: 12px;
            padding: 2.5rem;
            box-shadow: 0 4px 24px rgba(0,0,0,.08);
            text-align: center;
        }
        .denied-icon {
            font-size: 3rem;
            color: #dc3545;
            margin-bottom: 1rem;
        }
        .denied-title {
            font-size: 1.4rem;
            font-weight: 700;
            margin-bottom: .5rem;
        }
        .denied-sub {
            color: #6c757d;
            margin-bottom: 2rem;
            font-size: .95rem;
        }
    </style>
</head>
<body>
<div class="denied-wrap">
    <div class="denied-card">
        <div class="denied-icon">
            <i class="bi bi-shield-lock-fill"></i>
        </div>
        <div class="denied-title">Access Denied</div>
        <div class="denied-sub">
            You don't have permission to perform this action.<br />
            This area requires administrator access.
        </div>
        <a href="/" class="btn btn-primary">
            <i class="bi bi-house"></i> Back to Dashboard
        </a>
    </div>
</div>
</body>
</html>
