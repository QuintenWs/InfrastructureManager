@model InfrastructureManager.Web.ViewModels.Devices.DeviceDetailsViewModel
@using InfrastructureManager.Infrastructure.Identity

@{
    ViewData["Title"] = Model.Name;
}

<div class="details-header">
    <div>
        <div class="breadcrumbs">
            <a asp-controller="Departments" asp-action="Details"
               asp-route-id="@Model.DepartmentId">@Model.DepartmentName</a>
            <span>/</span>
            <a asp-action="Index">Devices</a>
            <span>/</span>
            <span>@Model.Name</span>
        </div>
        <h1 class="details-title">@Model.Name</h1>
        <div class="details-subtitle">
            @Model.DepartmentName — @Model.LocationName
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole(AppRoles.Admin))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id"
               class="btn btn-primary custom-btn">
                <i class="bi bi-pencil"></i> Edit
            </a>
        }
        <a asp-action="Index" class="btn btn-light custom-btn">Back</a>
    </div>
</div>

<div class="details-grid">
    <div class="details-main">

        <div class="content-card mb-4">
            <div class="details-section-title">Device Info</div>
            <div class="details-fields">
                <div class="details-field">
                    <span class="details-field-label">Name</span>
                    <span class="details-field-value">@Model.Name</span>
                </div>
                <div class="details-field">
                    <span class="details-field-label">Type</span>
                    <span class="details-field-value">@Model.DeviceType</span>
                </div>
                <div class="details-field">
                    <span class="details-field-label">Status</span>
                    <span class="details-field-value">
                        <span class="status-badge @InfrastructureManager.Web.Helpers.StatusBadgeHelper.GetStatusClass(Model.Status)">
                            @Model.Status
                        </span>
                    </span>
                </div>
                <div class="details-field">
                    <span class="details-field-label">Network</span>
                    <span class="details-field-value">
                        @if (Model.NetworkName != null)
                        {
                            <span>@Model.NetworkName</span>
                        }
                        else
                        {
                            <span class="text-secondary">Not assigned</span>
                        }
                    </span>
                </div>
            </div>
        </div>

        @if (Model.TypeFields.Any())
        {
            <div class="content-card mb-4">
                <div class="details-section-title">
                    <i class="bi bi-cpu me-1"></i> @Model.DeviceType Properties
                </div>
                <div class="details-fields">
                    @foreach (var field in Model.TypeFields)
                    {
                        <div class="details-field">
                            <span class="details-field-label">@field.Label</span>
                            <span class="details-field-value">
                                @if (field.FieldType == "checkbox")
                                {
                                    if (field.CurrentValue == "true")
                                    {
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                        <span class="ms-1">Yes</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle text-secondary"></i>
                                        <span class="ms-1">No</span>
                                    }
                                }
                                else if (field.FieldType == "url")
                                {
                                    <a href="@field.CurrentValue" target="_blank"
                                       class="table-link">
                                        @field.CurrentValue
                                        <i class="bi bi-box-arrow-up-right ms-1" style="font-size:.75rem"></i>
                                    </a>
                                }
                                else if (field.FieldType == "ipv4" || field.FieldType == "ipv6")
                                {
                                    <code>@field.CurrentValue</code>
                                }
                                else if (field.FieldType == "mac")
                                {
                                    <code>@field.CurrentValue</code>
                                }
                                else
                                {
                                    @field.CurrentValue
                                }
                            </span>
                        </div>
                    }
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="content-card mb-4">
                <div class="details-section-title">Notes</div>
                <div class="notes-content">@Model.Notes</div>
            </div>
        }

        <div class="content-card">
            <div class="details-section-title">
                <i class="bi bi-tools me-1"></i> Maintenance Log
            </div>

            @if (!Model.MaintenanceLogs.Any())
            {
                <div class="empty-notes mb-4">No maintenance notes yet.</div>
            }
            else
            {
                <div class="maintenance-timeline mb-4">
                    @foreach (var log in Model.MaintenanceLogs.OrderByDescending(l => l.CreatedAt))
                    {
                        <div class="maintenance-entry">
                            <div class="maintenance-dot"></div>
                            <div class="maintenance-body">
                                <div class="maintenance-meta">
                                    <span class="maintenance-user">@log.UserDisplayName</span>
                                    <span class="maintenance-time text-secondary">
                                        @log.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </div>
                                <div class="maintenance-note">@log.Note</div>
                                @if (User.IsInRole(AppRoles.Admin))
                                {
                                    <form asp-action="DeleteMaintenanceLog" method="post"
                                          onsubmit="return confirm('Delete this note?');"
                                          class="mt-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="logId"    value="@log.Id" />
                                        <input type="hidden" name="deviceId" value="@Model.Id" />
                                        <button type="submit"
                                                class="btn btn-link btn-sm p-0 text-danger"
                                                style="font-size:.8rem">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <form asp-action="AddMaintenanceLog" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="deviceId" value="@Model.Id" />
                <div class="d-flex gap-2">
                    <input type="text" name="note"
                           class="form-control custom-input flex-grow-1"
                           placeholder="Add maintenance note..."
                           maxlength="1000" required />
                    <button type="submit" class="btn btn-primary custom-btn">
                        <i class="bi bi-plus-lg"></i> Add
                    </button>
                </div>
            </form>
        </div>

    </div>

    <div class="details-sidebar">
        <div class="content-card">
            <div class="details-section-title">Quick Actions</div>
            <div class="quick-actions">
                @if (User.IsInRole(AppRoles.Admin))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id"
                       class="btn btn-primary custom-btn">
                        <i class="bi bi-pencil"></i> Edit Device
                    </a>
                    <form asp-action="Delete" asp-route-id="@Model.Id"
                          method="post"
                          onsubmit="return confirm('Delete @Model.Name?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger custom-btn w-100">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </form>
                    <a asp-controller="History" asp-action="Index"
                       asp-route-EntityType="Device" asp-route-EntityId="@Model.Id"
                       class="btn btn-light custom-btn">
                        <i class="bi bi-clock-history"></i> Geschiedenis van dit toestel
                    </a>
                }
                <a asp-controller="Departments" asp-action="Details"
                   asp-route-id="@Model.DepartmentId"
                   class="btn btn-light custom-btn">
                    <i class="bi bi-building"></i> Department
                </a>
                <a asp-action="Index" class="btn btn-light custom-btn">
                    All Devices
                </a>
            </div>
        </div>
    </div>
</div>
