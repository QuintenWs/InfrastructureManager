@model InfrastructureManager.Web.ViewModels.Contacts.CreateContactViewModel

@{
    ViewData["Title"] = "Add Contact";
}

<div class="page-header">
    <div>
        <div class="breadcrumb-nav">
            <a asp-action="Index">Contacts</a>
            <span>/</span>
            <span>Add</span>
        </div>
        <h1 class="page-heading">Add Contact</h1>
    </div>
</div>

<div class="form-page">
    <div class="form-card">
        <form asp-action="Create" method="post">

            <partial name="_ValidationSummary" />

            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="FirstName"></label>
                    <input asp-for="FirstName" class="form-control custom-input" />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LastName"></label>
                    <input asp-for="LastName" class="form-control custom-input" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="form-control custom-input" type="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Phone"></label>
                    <input asp-for="Phone" class="form-control custom-input" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Role"></label>
                    <input asp-for="Role" class="form-control custom-input"
                           placeholder="e.g. IT Manager, Network Admin" />
                </div>

                <div class="form-group">
                    <label asp-for="DepartmentId"></label>
                    <select asp-for="DepartmentId"
                            asp-items="Model.Departments"
                            class="form-select custom-input">
                        <option value="">Select Department</option>
                    </select>
                    <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                </div>

            </div>

            <div class="form-group mt-3">
                <label asp-for="Notes"></label>
                <textarea asp-for="Notes" rows="4" class="form-control custom-input"></textarea>
            </div>

            <div class="form-actions mt-4">
                <a asp-action="Index" class="btn btn-light custom-btn">Cancel</a>
                <button type="submit" class="btn btn-primary custom-btn">
                    <i class="bi bi-check-lg"></i>
                    Save Contact
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
